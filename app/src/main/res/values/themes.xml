<?xml version="1.0" encoding="utf-8"?>
<resources>

    <color name="orki_ivory_bg">#FAF9F4</color>
    <color name="orki_forest_green">#245C42</color>
    <color name="orki_pale_sage">#EEF3EB</color>

    <!--
        The normal app theme is deliberately light and has a solid ivory window background.
        A platform DeviceDefault theme can resolve to black in dark mode before Compose draws.
    -->
    <style name="Theme.MyApplication" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/orki_ivory_bg</item>
        <item name="android:colorAccent">@color/orki_forest_green</item>
        <item name="android:statusBarColor">@color/orki_ivory_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/orki_ivory_bg</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!--
        Android 12+ does not reliably use android:windowBackground for its system splash.
        This SplashScreen-compatible theme gives every supported Android version the same
        immediate ivory/forest-green launch frame, then hands off without a keep condition.
    -->
    <style name="Theme.MyApplication.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/orki_ivory_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_orki_inapp_logo_circle</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/orki_pale_sage</item>
        <item name="postSplashScreenTheme">@style/Theme.MyApplication</item>
    </style>

</resources>
